AuditLogs
| where TimeGenerated > ago(90d)
| where Category == "Policy"
| where OperationName == "Decision Item Summary"
| extend ReviewType = AdditionalDetails[1].value
| extend ResourceName = AdditionalDetails[2].value
| extend ReviewName = AdditionalDetails[4].value
| extend ReviewStatus = AdditionalDetails[8].value
| extend ResourceOwnerName = AdditionalDetails[10].value
| extend ResourceOwnerEmail = AdditionalDetails[11].value
| extend TargetUser = AdditionalDetails[13].value
| extend TargetUserEmail = AdditionalDetails[14].value
| extend ReviewDate = AdditionalDetails[15].value
| extend ReviewResult = AdditionalDetails[16].value
| extend Justification = AdditionalDetails[17].value
| extend ReviewerName = AdditionalDetails[19].value
| extend ReviewerEmail = AdditionalDetails[21].value
| extend AccessRecommendation = AdditionalDetails[22].value
| extend InitiatedBy_App = InitiatedBy.app.displayName
| extend TargetResourceType = TargetResources[0].type
| project
    TimeGenerated,
    Identity,
    ResourceName,
    ResourceOwnerName,
    ResourceOwnerEmail,
    TargetUser,
    TargetUserEmail,
    ReviewName,
    ReviewType,
    ReviewStatus,
    ReviewerName,
    ReviewerEmail,
    ReviewResult,
    Justification,
    ReviewDate,
    AccessRecommendation,
    Result,
    InitiatedBy_App,
    TargetResourceType,
    LoggedByService,
    OperationName
| order by TimeGenerated desc